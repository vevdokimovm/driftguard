# строка подключения к БД; для локальной разработки подойдёт SQLite
DATABASE_URL=postgresql+asyncpg://driftguard:driftguard@localhost:5432/driftguard
POSTGRES_PASSWORD=
# токен клиента: если задан, сервер требует заголовок X-API-Token, клиенту передаётся --token
API_TOKEN=
# общий токен агентов: если задан, снимки без заголовка X-Agent-Token отклоняются
AGENT_TOKEN=
# первый снимок нового хоста сразу становится эталоном
AUTO_BASELINE=true
# через сколько секунд без снимков хост считается потерянным (STALE)
STALE_AFTER_SECONDS=60
